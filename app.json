{
  "expo": {
    "name": "Famous From Here",
    "slug": "famous-from-here-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ryuhosoy.famousfromhereapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地から出身の有名人を検索するために位置情報を使用します。"
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "3b7a7be8-fe8c-40e3-a411-a754f8575a14"
      }
    }
  }
}
